{
  "name": "civcom-ios-domain-association",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "https://civcom.soia.info/apple-app-site-association", "zone_name": "soia.info" },
    { "pattern": "https://civcom.soia.info/.well-known/apple-app-site-association", "zone_name": "soia.info" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0 }
}
